# syntax=docker/dockerfile:1

ARG RUST_VERSION=1.82
ARG APP_NAME=symracing_virtual_mentor_backend
ARG SHARED_LIB_NAME=shared

# ------------------------------------------------------------------------------
# Build stage
# ------------------------------------------------------------------------------

FROM rust:${RUST_VERSION}-alpine AS build
ARG APP_NAME
ARG SHARED_LIB_NAME

# Set working directory inside the container
WORKDIR /app/${APP_NAME}

# Install system dependencies for building Rust projects
RUN apk add --no-cache clang lld musl-dev gcc git

# Copy manifest files first to leverage Docker layer caching for dependencies
COPY app/backend/Cargo.toml ./Cargo.toml
COPY app/shared/Cargo.toml ../${SHARED_LIB_NAME}/Cargo.toml

# Copy the actual source code
COPY app/backend/src ./src
COPY app/shared/src ../${SHARED_LIB_NAME}/src

# Build the Rust project in release mode
# If Cargo.lock is missing, it will be generated automatically
RUN cargo build --release

# Move the compiled binary to a known path
RUN cp ./target/release/${APP_NAME} /bin/server

# ------------------------------------------------------------------------------
# Final stage: minimal runtime container
# ------------------------------------------------------------------------------

FROM alpine:3.20 AS final
ARG APP_NAME

# Create a non-privileged user to run the application
ARG UID=10001
RUN adduser \
    --disabled-password \
    --gecos "" \
    --home "/nonexistent" \
    --shell "/sbin/nologin" \
    --no-create-home \
    --uid "${UID}" \
    appuser

# Define configuration directory and copy the config file
ENV CONFIG_DIR=/etc/${APP_NAME}/
RUN mkdir -p $CONFIG_DIR
COPY app/backend/backend-config.yaml $CONFIG_DIR
ENV BACKEND_CONFIG_PATH=$CONFIG_DIR/backend-config.yaml

# Copy the compiled binary from the build stage
COPY --from=build /bin/server /bin/

# Run the container as non-root user
USER appuser

# Expose the port your app listens on
EXPOSE 6666

# Define the default command
CMD ["/bin/server"]
